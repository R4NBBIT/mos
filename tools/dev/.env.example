# 이 파일을 같은 폴더에 .env 로 복사해서 채운다. .env 는 git에 올라가지 않는다.
# 개발은 테스트 앱(mos-test)과 테스트 서버로만 한다.

# 테스트 앱 › Bot › Reset Token (tools/verify/.env 와 같은 값)
DISCORD_BOT_TOKEN=

# 테스트 앱 › OAuth2 › Client ID / Client Secret(Reset Secret)
# OAuth2 › Redirects 에 http://localhost:5173/api/auth/connect/callback 를 등록해 둔다
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 디스코드 토큰을 DB에 암호화해 넣는 열쇠(32바이트 무작위 값의 base64). 만드는 법:
#   .venv\Scripts\python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# 바꾸면 저장된 계정은 다시 연결해야 한다. 운영 서버와 다른 값을 쓴다.
MOS_SECRET_KEY=

# 웹 개발 서버 주소(바꾸지 않음)
PUBLIC_ORIGIN=http://localhost:5173

# 내 PC의 DB 위치(레포 안 data 폴더, git에 안 올라감)
DB_PATH=data/mos.db

# (선택) 운영자 디스코드 사용자 ID: 월 송신량 80% 알림 등을 DM으로 받는다
OPERATOR_DISCORD_ID=

# (선택) 월 송신량 한도(MB). 구글 무료 등급은 1024. 80% 알림, 95% 첨부 막기
EGRESS_LIMIT_MB=1024
