# 이 파일을 같은 폴더에 .env 로 복사해서 채운다. .env 는 git에 올라가지 않는다.
# 값(특히 토큰·시크릿)은 채팅이나 다른 곳에 붙여 넣지 않는다.

# 테스트 앱 › Bot › Reset Token
VERIFY_BOT_TOKEN=

# 테스트 서버 A의 일반 채팅 채널 ID, 포럼 채널 ID (디스코드 개발자 모드 › 우클릭 › ID 복사)
VERIFY_TEXT_CHANNEL=
VERIFY_FORUM_CHANNEL=

# 다른 서버 이모지를 빌려 올 서버 B ID (비우면 봇이 들어간 다른 서버를 자동으로 고름)
VERIFY_GUILD_B=

# PKCE 점검용: 테스트 앱 › OAuth2 의 Client ID / Client Secret
VERIFY_CLIENT_ID=
VERIFY_CLIENT_SECRET=
# OAuth2 Redirects 에 http://127.0.0.1:53682/callback 을 등록
VERIFY_REDIRECT_PORT=53682
