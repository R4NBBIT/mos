<?xml version="1.0" encoding="utf-8"?>
<!-- TODO 위젯(테마별 모양, TodoWidget.java가 고름). 줄을 누르면 완료 켜고 끄기, ↻ 새로 고침, 날짜 누르면 ㅁㅇㅅ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/w_memo_bg" android:orientation="vertical" android:padding="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:background="@drawable/w_memo_title" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="6dp">
  <TextView android:singleLine="true" android:ellipsize="end" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="TODO.txt - 메모장" android:textSize="12sp" android:textColor="#FF111111" />
  <TextView android:singleLine="true" android:ellipsize="end" android:id="@+id/refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="4dp" android:text="↻" android:textColor="#FF444444" android:textSize="17sp" />
</LinearLayout>
<TextView android:singleLine="true" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:paddingStart="10dp" android:text="파일   편집   서식   보기   도움말" android:textColor="#FF111111" android:textSize="12sp" />
<TextView android:layout_width="match_parent" android:layout_height="1dp" android:background="#FFE5E5E5" />
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp">
  <LinearLayout android:id="@+id/head" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <TextView android:singleLine="true" android:ellipsize="end" android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#FF6B6B6B" android:fontFamily="monospace" />
    <TextView android:singleLine="true" android:ellipsize="end" android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#FF6B6B6B" android:fontFamily="monospace" android:paddingStart="6dp" />
  </LinearLayout>
  <TextView android:maxLines="2" android:ellipsize="end" android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#FF6B6B6B" android:fontFamily="monospace" android:visibility="gone" android:paddingTop="6dp" android:paddingBottom="6dp" />
<ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@null" android:dividerHeight="0dp" android:scrollbars="vertical" android:fadeScrollbars="true" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:background="@drawable/w_memo_status" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
  <TextView android:singleLine="true" android:ellipsize="end" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="줄 1, 열 1" android:textSize="11sp" android:textColor="#FF444444" />
  <TextView android:singleLine="true" android:ellipsize="end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100%    UTF-8" android:textSize="11sp" android:textColor="#FF444444" />
</LinearLayout>
</LinearLayout>
