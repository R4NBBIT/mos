</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:background="@drawable/w_memo_status" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
  <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="줄 1, 열 1" android:textSize="11sp" android:textColor="#FF444444" />
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100%    UTF-8" android:textSize="11sp" android:textColor="#FF444444" />
