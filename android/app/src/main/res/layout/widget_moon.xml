<?xml version="1.0" encoding="utf-8"?>
<!-- TODO 위젯(테마별 모양, TodoWidget.java가 고름). 줄을 누르면 완료 켜고 끄기, ↻ 새로 고침, 날짜 누르면 ㅁㅇㅅ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/w_moon_bg" android:orientation="vertical" android:padding="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
  <LinearLayout android:id="@+id/head" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:singleLine="true" android:ellipsize="end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TODO" android:textSize="11sp" android:textColor="#FF62666D" android:textStyle="bold" android:letterSpacing="0.14" />
    <TextView android:singleLine="true" android:ellipsize="end" android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="17sp" android:textColor="#FF26272B" android:textStyle="bold" />
  </LinearLayout>
  <TextView android:singleLine="true" android:ellipsize="end" android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textColor="#FF26272B" android:textStyle="bold" />
  <TextView android:singleLine="true" android:ellipsize="end" android:id="@+id/refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="4dp" android:text="↻" android:textColor="#FF62666D" android:textSize="17sp" />
</LinearLayout>
<ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="10dp" android:layout_marginBottom="6dp" android:max="100" android:progressDrawable="@drawable/w_moon_bar" />
<TextView android:maxLines="2" android:ellipsize="end" android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#FF62666D" android:visibility="gone" android:paddingTop="6dp" android:paddingBottom="6dp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
<ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@null" android:dividerHeight="0dp" android:scrollbars="vertical" android:fadeScrollbars="true" />
</LinearLayout>
</LinearLayout>
