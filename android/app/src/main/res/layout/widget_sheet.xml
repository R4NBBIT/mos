  <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#FF1F2328" android:paddingStart="6dp" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:orientation="horizontal">
