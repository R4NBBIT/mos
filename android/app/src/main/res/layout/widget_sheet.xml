<?xml version="1.0" encoding="utf-8"?>
<!-- TODO 위젯(테마별 모양, TodoWidget.java가 고름). 줄을 누르면 완료 켜고 끄기, ↻ 새로 고침, 날짜 누르면 ㅁㅇㅅ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/w_sheet_bg" android:orientation="vertical" android:padding="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:background="@drawable/w_sheet_title" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="6dp">
  <TextView android:singleLine="true" android:ellipsize="end" android:layout_width="18dp" android:layout_height="18dp" android:background="#FFFFFFFF" android:gravity="center" android:text="X" android:textColor="#FF1F6E43" android:textSize="11sp" android:textStyle="bold" />
  <TextView android:singleLine="true" android:ellipsize="end" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="TODO.xlsx" android:textSize="12sp" android:textColor="#FFFFFFFF" android:paddingStart="8dp" />
  <TextView android:singleLine="true" android:ellipsize="end" android:id="@+id/refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="4dp" android:text="↻" android:textColor="#FFFFFFFF" android:textSize="17sp" />
</LinearLayout>
<LinearLayout android:id="@+id/head" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
  <TextView android:singleLine="true" android:ellipsize="end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="fx" android:textSize="12sp" android:textColor="#FF5F6368" android:paddingEnd="8dp" android:textStyle="italic" />
  <TextView android:singleLine="true" android:ellipsize="end" android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#FF1F2328" />
  <TextView android:singleLine="true" android:ellipsize="end" android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#FF1F2328" android:paddingStart="6dp" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:orientation="horizontal">
  <TextView android:singleLine="true" android:ellipsize="end" android:layout_width="30dp" android:layout_height="match_parent" android:background="@drawable/w_sheet_num" />
  <TextView android:singleLine="true" android:ellipsize="end" android:layout_width="40dp" android:layout_height="match_parent" android:background="@drawable/w_sheet_num" android:gravity="center" android:text="A" android:textColor="#FF5F6368" android:textSize="11sp" />
  <TextView android:singleLine="true" android:ellipsize="end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/w_sheet_num" android:gravity="center" android:text="B" android:textColor="#FF5F6368" android:textSize="11sp" />
  <TextView android:singleLine="true" android:ellipsize="end" android:layout_width="64dp" android:layout_height="match_parent" android:background="@drawable/w_sheet_num" android:gravity="center" android:text="C" android:textColor="#FF5F6368" android:textSize="11sp" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="25dp" android:orientation="horizontal">
  <TextView android:singleLine="true" android:ellipsize="end" android:layout_width="30dp" android:layout_height="match_parent" android:background="@drawable/w_sheet_num" android:gravity="center" android:text="1" android:textColor="#FF5F6368" android:textSize="11sp" />
  <TextView android:singleLine="true" android:ellipsize="end" android:layout_width="40dp" android:layout_height="match_parent" android:background="@drawable/w_sheet_cell" android:gravity="center" android:text="완료" android:textColor="#FF1F2328" android:textSize="12sp" android:textStyle="bold" />
  <TextView android:singleLine="true" android:ellipsize="end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/w_sheet_cell" android:gravity="center_vertical" android:paddingStart="6dp" android:text="TODO" android:textColor="#FF1F2328" android:textSize="12sp" android:textStyle="bold" />
  <TextView android:singleLine="true" android:ellipsize="end" android:layout_width="64dp" android:layout_height="match_parent" android:background="@drawable/w_sheet_cell" android:gravity="center_vertical|end" android:paddingEnd="6dp" android:text="시각" android:textColor="#FF1F2328" android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
<ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@null" android:dividerHeight="0dp" android:scrollbars="vertical" android:fadeScrollbars="true" />
<TextView android:maxLines="2" android:ellipsize="end" android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#FF5F6368" android:visibility="gone" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingBottom="6dp" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:background="@drawable/w_sheet_tabs" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="36dp">
  <TextView android:singleLine="true" android:ellipsize="end" android:layout_width="wrap_content" android:layout_height="match_parent" android:background="#FFFFFFFF" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="오늘" android:textColor="#FF1F6E43" android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
</LinearLayout>
