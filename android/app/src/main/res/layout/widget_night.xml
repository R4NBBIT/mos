<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/w_night_bg" android:orientation="vertical" android:padding="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
  <LinearLayout android:id="@+id/head" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TODO" android:textSize="11sp" android:textColor="#FFA7A08F" android:textStyle="bold" android:letterSpacing="0.14" />
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="17sp" android:textColor="#FFECE7DC" android:textStyle="bold" />
  </LinearLayout>
  <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textColor="#FFECE7DC" android:textStyle="bold" />
  <TextView android:id="@+id/refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="4dp" android:text="↻" android:textColor="#FFA7A08F" android:textSize="17sp" />
</LinearLayout>
<ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="10dp" android:layout_marginBottom="6dp" android:max="100" android:progressDrawable="@drawable/w_night_bar" />
<TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#FFA7A08F" android:visibility="gone" android:paddingTop="6dp" android:paddingBottom="6dp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
